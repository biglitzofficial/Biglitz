# apps/api (set these in Railway; never commit real values)
NODE_ENV=production
PORT=8080
WEB_ORIGIN=https://team.biglitz.in
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Entire service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret that n8n sends in the X-Intake-Secret header
INTAKE_SECRET=
N8N_WEBHOOK_URL=https://n8n-production-5db3.up.railway.app/webhook/REPLACE_ME

# Local emulator (optional): leave FIREBASE_SERVICE_ACCOUNT_JSON empty and set
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# apps/web (Vite build-time, set in Firebase Hosting build / local .env)
VITE_API_URL=https://api.team.biglitz.in
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
