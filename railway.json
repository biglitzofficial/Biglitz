{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm run build:shared && npm run build -w @biglitz/api" },
  "deploy": {
    "startCommand": "npm run start -w @biglitz/api",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
