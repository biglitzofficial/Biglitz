{
  "name": "@biglitz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:cron": "node dist/cron/dispatcher.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "test:int": "firebase emulators:exec --config ../../firebase.json --only firestore --project demo-biglitz \"vitest run -c vitest.integration.config.ts\"",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --only firestore --project demo-biglitz \"vitest run -c vitest.rules.config.ts\""
  },
  "dependencies": {
    "@biglitz/shared": "*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.1.0",
    "firebase-admin": "^13.0.1",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.9.0",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
